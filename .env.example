# Proveedor requerido por la entrega: openai | anthropic
LLM_PROVIDER=openai

# Configura solamente la key del proveedor seleccionado
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelos
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_MODEL=claude-sonnet-4-6

# Persistencia local
CHECKPOINT_DB=./agent_checkpoints.sqlite

# Seguridad operacional
RECURSION_LIMIT=10
